# ==============================================================================
# ODIN RESEARCH — VENUE CREDENTIALS & CLIENT CONFIGURATION
# https://odinresearch.com
# ==============================================================================
#
# QUICK START FOR CLIENTS:
# 1. By default, you DO NOT need to configure anything in this file!
#    - MetaTrader 5: If MT5 is already running on your PC, ODIN RESEARCH
#      automatically connects to your active account via local Windows IPC.
#    - HyperLiquid: Real-time market data, basis spreads, and funding rates
#      stream directly from the HyperLiquid Info API (no wallet/keys required).
#
# 2. OPTIONAL: If you want ODIN RESEARCH to log into a specific MT5 account
#    automatically on startup, or connect to private wallets, fill in the
#    settings below and rename this file to `.env`.
# ==============================================================================

# --- MetaTrader 5 Configuration (Optional) ---
# Your MetaTrader 5 account number (e.g. 12345678)
MT5_LOGIN=

# Your MetaTrader 5 account password
MT5_PASSWORD=

# Your broker server name (e.g. ICMarketsSC-Demo, Pepperstone-Demo, FTMO-Demo)
MT5_SERVER=

# Path to terminal64.exe (Optional - leave blank if installed in default Program Files)
# Example: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# --- HyperLiquid Configuration (Optional) ---
# Builder DEX identifier (default is "xyz" for synthetic TradFi perps)
HL_DEX=xyz

# HyperLiquid Wallet Address (Optional: for private balances)
HL_WALLET_ADDRESS=

# HyperLiquid API Secret / Private Key (Optional: for automated order execution)
HL_SECRET_KEY=
